<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CodeGraphStandalone.exe (experimental; docs/CODE_GRAPH_STANDALONE.md): the
    code graph of any .NET assembly, without the game. It compiles the
    Inspector's CodeGraphModel.cs (Mono.Cecil only, no Unity) and shows the
    Bridge's page.html in WebView2; the page's calls are answered inside this
    process, with no port and no network. Opens a DLL, several, a folder or a
    Mono Unity game's folder.

    Not packed into a release yet: where it lives is still open.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CodeGraphStandalone</AssemblyName>
    <RootNamespace>DragNWash.CodeGraph.Standalone</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/codegraph-standalone</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- The graph itself: the same file the Inspector builds, so the two cannot drift apart. -->
    <Compile Include="..\src\DragNWash.ModFramework.Inspector\CodeGraphModel.cs" Link="Shared\CodeGraphModel.cs" />
    <!-- The same page the Bridge serves. -->
    <EmbeddedResource Include="..\src\DragNWash.ModFramework.Bridge\Page\page.html" LogicalName="page.html" Link="Shared\page.html" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- JavaScriptSerializer: the page's JSON, both ways. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
