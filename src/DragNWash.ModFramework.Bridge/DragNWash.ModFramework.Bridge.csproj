<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DragNWash.ModFramework.Bridge</AssemblyName>
    <RootNamespace>DragNWash.ModFramework.Bridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- A library on top of the core, with its own version. Keep in sync with Bridge.Version. -->
    <Version>0.1.0</Version>
    <FileVersion>0.1.0</FileVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DragNWash.ModFramework\DragNWash.ModFramework.csproj" Private="false" />
    <!-- The Bridge tab and the console command live in the Tool window. -->
    <ProjectReference Include="..\DragNWash.ModFramework.ToolWindow\DragNWash.ModFramework.ToolWindow.csproj" Private="false" />
  </ItemGroup>

  <!-- The Overrides library's small JSON reader, compiled in. -->
  <ItemGroup>
    <Compile Include="..\DragNWash.ModFramework.Overrides\Json.cs" Link="Json.cs" />
  </ItemGroup>

  <!-- The page on this computer (docs/CODE_GRAPH.md): one file, served from the DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Page\page.html" LogicalName="page.html" />
  </ItemGroup>

  <!-- Shares libs/ with the core project; see tools/copy-libs.ps1. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>../DragNWash.ModFramework/libs/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>../DragNWash.ModFramework/libs/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>../DragNWash.ModFramework/libs/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../DragNWash.ModFramework/libs/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
