<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DragNWash.ModFramework</AssemblyName>
    <RootNamespace>DragNWash.ModFramework</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Keep in sync with ModFramework.Version. -->
    <Version>1.1.0</Version>
    <FileVersion>1.1.0</FileVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The list of switched-off mods is shared with the preloader patcher. -->
  <ItemGroup>
    <Compile Include="..\DragNWash.ModFramework.Preloader\DisabledMods.cs" Link="Mods\DisabledMods.cs" />
  </ItemGroup>

  <!--
    These reference assemblies are NOT committed (libs/ is ignored). Copy them from your
    own game install with tools/copy-libs.ps1, which lists every file.
  -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>libs\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>libs\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>libs/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>libs\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>libs\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>libs\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>libs\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>libs\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>libs\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>libs\UnityEngine.TextCoreFontEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>libs\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Naelstrof.UnityScriptableSettings"><HintPath>libs/Naelstrof.UnityScriptableSettings.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Localization"><HintPath>libs/Unity.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>libs\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
