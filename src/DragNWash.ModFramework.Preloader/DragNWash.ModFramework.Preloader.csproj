<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DragNWash.ModFramework.Preloader</AssemblyName>
    <RootNamespace>DragNWash.ModFramework</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.6.0</Version>
    <FileVersion>1.6.0</FileVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shares libs/ with the framework project; see tools/copy-libs.ps1. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\DragNWash.ModFramework\libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>..\DragNWash.ModFramework\libs\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
